{
  "name": "@kepler-app/their-time-plugin",
  "version": "1.0.0",
  "description": "See local times of friends across timezones in Kepler.",
  "type": "module",
  "keywords": [
    "kepler",
    "kepler-plugin",
    "launcher",
    "timezone"
  ],
  "files": [
    "dist"
  ],
  "kepler": {
    "apiVersion": 1,
    "manifest": "dist/manifest.json",
    "entry": "dist/index.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbiq-one/kepler-their-time.git"
  },
  "homepage": "https://github.com/orbiq-one/kepler-their-time#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "kepler-plugin bundle src/index.ts --out dist",
    "install:local": "kepler-plugin bundle src/index.ts --out \"$HOME/Library/Application Support/Kepler/Plugins/their-time.keplugin\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@kepler-app/plugin-sdk": "1.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
